# =============================================================================
# Averonix Google Workspace Integration — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# --- Google OAuth 2.0 Credentials (REQUIRED) ---------------------------------
# Obtain these from the Google Cloud Console:
#   APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Token Encryption Key (REQUIRED) ------------------------------------------
# 32-byte hex or base64 key used to encrypt OAuth tokens at rest.
# Generate with: openssl rand -hex 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# --- OAuth Redirect URI (optional — defaults to the server callback URL) ------
# Must match the Authorized Redirect URI in your Google Cloud Console.
# Example: https://your-app.com/api/integrations/google-workspace/oauth/callback
# GOOGLE_REDIRECT_URI=

# --- Frontend Base URL (optional — defaults to the request origin) ------------
# Used for post-OAuth redirect back to the dashboard.
# Example: https://your-app.com
# AVERONIX_FRONTEND_BASE_URL=

# --- Workspace / User Context (optional — defaults to headers or fallbacks) ---
# AVERONIX_WORKSPACE_ID=default-workspace
# AVERONIX_CONNECTED_BY_USER_ID=

# --- Scopes (optional — defaults to the required Directory/Reports scopes) ----
# Space- or comma-separated list of Google OAuth scopes.
# GOOGLE_WORKSPACE_SCOPES=

# --- Database (optional — one of the following) --------------------------------
# For Cloudflare D1: set the D1 binding name (usually AVERONIX_DB or DB).
# For local file-based storage: set a writable path.
# AVERONIX_DB=your-d1-binding-name
AVERONIX_LOCAL_DB_PATH=.averonix/google-workspace-db.json
